# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these in Project Settings -> Environment Variables.

# Neon Postgres (auto-provisioned by the Vercel Neon integration)
DATABASE_URL=

# Better Auth: random string, at least 32 chars (openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Optional: canonical auth URL, e.g. https://nara.example.com
# If unset, falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL.
BETTER_AUTH_URL=

# Resend
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Nara <hello@yourdomain.com>"
# If unset, uses onboarding@resend.dev, which only delivers to your Resend account email.
EMAIL_FROM=
# Inbox that receives contact-form submissions
CONTACT_INBOX_EMAIL=

# --- Optional: live listing sync (Production only; Vercel Cron does not run on previews) ---
# RentCast listings API key (https://app.rentcast.io/app/api). Server-only.
RENTCAST_API_KEY=
# Random string, at least 32 chars, unique to this project. Vercel Cron sends it
# as a Bearer token to /api/cron/sync-listings; requests without it get 401.
CRON_SECRET=
# Each run makes 18 billable RentCast requests (9 markets x sale + rental).
# Sync is skipped unless this is exactly "true".
LISTING_SYNC_ENABLED=

# Comma-separated immutable Better Auth user IDs authorized for /dashboard/leads.
# Empty denies everyone. Select IDs from verified trusted accounts; never use emails.
NARA_ADMIN_USER_IDS=
